# Database (PostgreSQL 15/16 + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5432/content_studio

# Security & Encryption (AES-256-GCM for BYOK API Keys + JWT)
SECRET_KEY=content-studio-super-secret-jwt-key-2026-change-in-prod
ENCRYPTION_SECRET=content-studio-aes256-encryption-secret-2026

# Default Free Tier Gateway (System 9Router)
SYSTEM_9ROUTER_BASE_URL=http://127.0.0.1:20128/v1
SYSTEM_9ROUTER_API_KEY=sk-9router-system-free
SYSTEM_9ROUTER_DEFAULT_MODEL=auto
DAILY_FREE_QUOTA_DEFAULT=50

# Feedback Integrations (Optional - configurable in Admin UI)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GOOGLE_SHEETS_WEBHOOK_URL=

# Author Donation / VietQR Defaults (Configurable in Admin UI)
AUTHOR_BANK_ID=MB
AUTHOR_ACCOUNT_NO=0987654321
AUTHOR_ACCOUNT_NAME=TAC GIA CONTENT STUDIO
AUTHOR_DONATE_NOTE=Ung ho phat trien AI Content Studio

# Frontend -> Backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000
